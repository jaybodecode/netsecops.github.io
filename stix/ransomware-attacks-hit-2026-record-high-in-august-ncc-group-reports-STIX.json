        {
            "type": "indicator",
            "spec_version": "2.1",
            "id": "indicator--f47a9aee-a8d8-52f4-a416-1f1b7361025b",
            "created_by_ref": "identity--f165d4a1-7c3b-4e9f-b2d8-6a5e8c2f1b9d",
            "created": "2026-09-24T22:12:21.935849Z",
            "modified": "2026-09-24T22:12:21.935849Z",
            "name": "VSSAdmin Shadow Copy Deletion",
            "description": "Detects the execution of `vssadmin delete shadows`, a command commonly used by ransomware to prevent system recovery.",
            "indicator_types": [
                "malicious-activity"
            ],
            "pattern": "title: VSSAdmin Shadow Copy Deletion\nid: 9c55a53e-51e8-4191-98ac-83519fbed59e\nstatus: experimental\ndescription: Detects the use of vssadmin.exe to delete volume shadow copies, a common technique used by ransomware to inhibit system recovery.\nreferences:\n  - https://www.nccgroup.com/newsroom/ncc-group-monthly-threat-pulse-review-of-august/\nauthor: cyber.netsecops.io\ndate: 2026-09-23\ntags:\n  - attack.t1490\n  - attack.impact\nlevel: high\nlogsource:\n  category: process_creation\n  product: windows\ndetection:\n  selection:\n    Image|endswith: '\\vssadmin.exe'\n    CommandLine|contains|all:\n      - 'delete'\n      - 'shadows'\n  condition: selection",
            "pattern_type": "sigma",
            "valid_from": "2026-09-24T22:12:21.615429Z"
        },
        {
            "type": "indicator",
            "spec_version": "2.1",
            "id": "indicator--73f09c9e-4177-501b-a748-f83266e1e8db",
            "created_by_ref": "identity--f165d4a1-7c3b-4e9f-b2d8-6a5e8c2f1b9d",
            "created": "2026-09-24T22:12:21.940263Z",
            "modified": "2026-09-24T22:12:21.940263Z",
            "name": "Data Archiving with 7-Zip for Exfiltration",
            "description": "Detects the use of the 7-Zip utility to create archive files, a common technique for data staging before exfiltration.",
            "indicator_types": [
                "malicious-activity"
            ],
            "pattern": "title: Data Archiving with 7-Zip for Exfiltration\nid: a139f984-d136-4412-a989-efadaf9ff0a1\nstatus: experimental\ndescription: Detects the use of 7-Zip (7z.exe) to create large archives, which is often a precursor to data exfiltration by ransomware groups.\nreferences:\n  - https://www.nccgroup.com/newsroom/ncc-group-monthly-threat-pulse-review-of-august/\nauthor: cyber.netsecops.io\ndate: 2026-09-23\ntags:\n  - attack.t1560.001\n  - attack.collection\nlevel: medium\nlogsource:\n  category: process_creation\n  product: windows\ndetection:\n  selection:\n    Image|endswith: '\\7z.exe'\n    CommandLine|contains: ' a '\n  filter_legit_path:\n    CurrentDirectory|startswith:\n      - 'C:\\Program Files\\'\n      - 'C:\\Program Files (x86)\\'\n  condition: selection and not filter_legit_path",
            "pattern_type": "sigma",
            "valid_from": "2026-09-24T22:12:21.615429Z"
        },
