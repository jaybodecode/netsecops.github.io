        {
            "type": "indicator",
            "spec_version": "2.1",
            "id": "indicator--532fd359-00b5-5d0b-9124-0c514f5c369a",
            "created_by_ref": "identity--f165d4a1-7c3b-4e9f-b2d8-6a5e8c2f1b9d",
            "created": "2026-11-12T00:11:07.953103Z",
            "modified": "2026-11-12T00:11:07.953103Z",
            "name": "N-able N-central Suspicious Child Process",
            "description": "Detects the N-central Java process spawning unusual child processes like shells or network utilities, a strong indicator of remote code execution from vulnerabilities like CVE-2026-125878.",
            "indicator_types": [
                "malicious-activity"
            ],
            "pattern": "[domain-name:value = 'com.nable.server.main.Main']",
            "pattern_type": "stix",
            "pattern_version": "2.1",
            "valid_from": "2026-11-12T00:10:52.019064Z",
            "x_netsecio_lossy_fallback": true
        },
        {
            "type": "indicator",
            "spec_version": "2.1",
            "id": "indicator--fcbca4e6-f95c-5de1-91d2-7729b0393139",
            "created_by_ref": "identity--f165d4a1-7c3b-4e9f-b2d8-6a5e8c2f1b9d",
            "created": "2026-11-12T00:11:07.96154Z",
            "modified": "2026-11-12T00:11:07.96154Z",
            "name": "N-able N-central Suspicious Child Process",
            "description": "Detects the N-central Java process spawning unusual child processes like shells or network utilities, a strong indicator of remote code execution from vulnerabilities like CVE-2026-125878.",
            "indicator_types": [
                "malicious-activity"
            ],
            "pattern": "title: N-able N-central Suspicious Child Process\nid: 2f8b1c9a-7e6d-4f5a-8b3c-1d9e8f7a6b5c\nstatus: experimental\ndescription: Detects suspicious child processes such as shells or network utilities being spawned by the N-able N-central Java process, which may indicate exploitation of Able2Shell RCE vulnerabilities like CVE-2026-125878.\nauthor: cyber.netsecops.io\ndate: 2026-11-11\nreferences:\n  - https://thehackernews.com/2026/11/n-able-takes-hosted-n-central-offline.html\ntags:\n  - attack.t1059\n  - attack.execution\nlevel: critical\nlogsource:\n  category: process_creation\n  product: windows\ndetection:\n  selection_parent:\n    ParentImage|contains: 'java'\n    ParentCommandLine|contains: 'com.nable.server.main.Main'\n  selection_child:\n    Image|endswith:\n      - '\\bash.exe'\n      - '\\sh.exe'\n      - '\\powershell.exe'\n      - '\\curl.exe'\n      - '\\wget.exe'\n  condition: all of selection_*\nfalsepositives:\n  - Unlikely, but custom administrative scripts could trigger this rule.",
            "pattern_type": "sigma",
            "valid_from": "2026-11-12T00:10:52.019064Z"
        },
        {
            "type": "indicator",
            "spec_version": "2.1",
            "id": "indicator--6efdb956-8cb9-506b-8dd7-74e5c4964d80",
            "created_by_ref": "identity--f165d4a1-7c3b-4e9f-b2d8-6a5e8c2f1b9d",
            "created": "2026-11-12T00:11:07.965605Z",
            "modified": "2026-11-12T00:11:07.965605Z",
            "name": "N-able N-central XXE Injection Attempt",
            "description": "Detects unusual POST requests to N-central login endpoints containing XML payloads, which could indicate attempts to exploit the XXE vulnerability (CVE-2026-125883).",
            "indicator_types": [
                "malicious-activity"
            ],
            "pattern": "title: N-able N-central XXE Injection Attempt\nid: 8a7b6c5d-4e3f-4a2b-9c8d-1e9f8a7b6c5d\nstatus: experimental\ndescription: Detects web requests to the N-able N-central login endpoint containing patterns indicative of XML External Entity (XXE) injection attempts, related to CVE-2026-125883.\nauthor: cyber.netsecops.io\ndate: 2026-11-11\nreferences:\n  - https://thehackernews.com/2026/11/n-able-takes-hosted-n-central-offline.html\ntags:\n  - attack.t1190\n  - attack.initial_access\nlevel: high\nlogsource:\n  category: proxy\ndetection:\n  selection:\n    cs-method: 'POST'\n    c-uri|contains: '/dms/Login'\n    body|contains|all:\n      - '<?xml'\n      - '<!ENTITY'\n      - 'SYSTEM'\n  condition: selection\nfalsepositives:\n  - Legitimate but unusual XML payloads.",
            "pattern_type": "sigma",
            "valid_from": "2026-11-12T00:10:52.019064Z"
        },
