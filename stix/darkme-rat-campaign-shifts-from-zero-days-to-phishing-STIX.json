            "modified": "2026-09-23T16:18:57.116369Z",
            "name": "DarkMe RAT C2 Network Connection",
            "description": "Detects outbound network traffic to the DarkMe RAT C2 domain or IP address on the specific C2 port 7712.",
            "indicator_types": [
                "malicious-activity"
            ],
            "pattern": "[network-traffic:dst_ref.value = '67.43.50.11' AND network-traffic:dst_port = 7712] OR [network-traffic:dst_ref.value = 'thatawful.boutique' AND network-traffic:dst_port = 7712]",
            "pattern_type": "stix",
            "pattern_version": "2.1",
            "valid_from": "2026-09-23T16:18:54.93979Z",
            "x_netsecio_sigma_rule": "title: DarkMe RAT C2 Connection\nid: 7c8b1a2d-3e4f-4a5b-8c9d-0e1f2a3b4c5d\nstatus: experimental\ndescription: Detects network connections to known DarkMe RAT C2 infrastructure on port 7712.\nreferences:\n  - https://www.huntress.com/blog/darkme-rat-abandons-exploits\nauthor: cyber.netsecops.io\ndate: 2026-09-23\ntags:\n  - attack.t1095\n  - attack.command_and_control\nlevel: critical\nlogsource:\n  category: network_connection\n  product: windows\ndetection:\n  selection_ip:\n    DestinationIp: '67.43.50.11'\n    DestinationPort: 7712\n    Initiated: 'true'\n  selection_dns:\n    DestinationHostname: 'thatawful.boutique'\n    DestinationPort: 7712\n    Initiated: 'true'\n  condition: 1 of them"
        },
