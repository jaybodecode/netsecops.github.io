            ],
            "pattern": "title: DarkMe RAT Process Hollowing of clspack.exe\nid: 8d9e0f1a-2b3c-4d5e-8f9a-0b1c2d3e4f5a\nstatus: experimental\ndescription: Detects the legitimate process clspack.exe making unexpected outbound network connections, a behavior associated with DarkMe RAT process hollowing.\nreferences:\n  - https://www.huntress.com/blog/darkme-rat-abandons-exploits\nauthor: cyber.netsecops.io\ndate: 2026-09-23\ntags:\n  - attack.t1055.012\n  - attack.defense_evasion\nlevel: high\nlogsource:\n  category: network_connection\n  product: windows\ndetection:\n  selection:\n    Image|endswith: '\\clspack.exe'\n    Initiated: 'true'\n  filter_local:\n    DestinationIp|cidr:\n      - '127.0.0.0/8'\n      - '::1/128'\n  condition: selection and not filter_local",
            "pattern_type": "sigma",
            "valid_from": "2026-09-23T16:18:54.93979Z"
        },
